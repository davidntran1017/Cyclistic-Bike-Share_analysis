                <zone forceUpdate='true' h='11272' id='22' type-v2='text' w='99086' x='457' y='87835'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• Members generated </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>63%</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> of all rides.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• Casual riders averaged </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>24.1 minutes</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> per ride versus </run>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>12.3 minutes</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'> for members.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• Members ride primarily on weekdays, suggesting commuting behavior.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• Casual riders ride more frequently on weekends and during warmer months.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>• Electric bikes are the preferred vehicle type for both rider groups.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
